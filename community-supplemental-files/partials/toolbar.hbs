<div class="toolbar" role="navigation">
{{> nav-toggle}}
  {{!-- {{#with site.homeUrl}}
  <a href="{{{relativize this}}}" aria-label="Cloudnative Documentation Home" class="home-link{{#if @root.page.home}} is-current{{/if}}"></a>
  {{/with}} --}}
{{> breadcrumbs}}
{{> page-versions}}
  {{#if (and page.editUrl (or env.FORCE_SHOW_EDIT_PAGE_LINK (not page.origin.private)))}}
  <div class="edit-this-page">
    {{#if (eq page.attributes.community-only "true")}}
      {{! Constructs URL using page.componentVersion.version and page.src.relative }}
      <a href="{{page.origin.webUrl}}/edit/{{page.origin.branch}}/community-docs/{{page.attributes.target-edit-version}}/modules/ROOT/pages/{{page.relativeSrcPath}}"><strong>Edit</strong></a>
    {{else}}
      <a href="{{page.origin.webUrl}}/edit/{{page.origin.branch}}/versions/{{page.attributes.target-edit-version}}/modules/en/pages/{{page.attributes.product-path}}"><strong>Edit</strong></a>
    {{/if}}
  </div>
  {{/if}}
      {{#if env.SITE_SEARCH_PROVIDER}}
      <div class="navbar-item search hide-for-print">
        <div id="search-field" class="field">
          <label class="visual-search-label-bc" for="search-input">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</label>
          <input label="Search" aria-label="Search" id="search-input" type="text" placeholder="Search the docs" {{#if page.home}} autofocus{{/if}}>
          <label class="filter checkbox" style="display: none">
            <input type="checkbox" data-facet-filter="component:{{page.component.name}}" checked> Only this project
          </label>
        </div>
      </div>
      {{/if}}
</div>

<div style="background: black; color: lime; padding: 5px; font-size: 11px;">
  <strong>Available attributes:</strong><br>
  {{#each page.attributes}}
    {{@key}} = {{this}}<br>
  {{/each}}
</div>